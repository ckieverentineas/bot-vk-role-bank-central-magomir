{
  "compilerOptions": {
    "target": "ESNext",                          
    "module": "CommonJS",                    
    "lib": ["es2021", "es2022", "esnext", "DOM"],   
    "moduleResolution": "Node",                  
    "allowJs": true,
    "outDir": "../build",                          
    "rootDir": "../",
    "strict": true,         
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["../node_modules/@types", "./types"]
  }
}
